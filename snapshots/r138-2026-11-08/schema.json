{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R138 aggregate process summary, not final PRISMA or an efficacy dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "status",
    "record_framework",
    "working_routes",
    "record_route_delta",
    "human_review_aggregate",
    "review_method_boundary",
    "source_use_adoptions",
    "received_material_aggregate",
    "previously_adopted_anchor",
    "numeric_gate_aggregate",
    "remaining_boundaries",
    "historical_reproduction_snapshot"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "record_framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records_identified",
        "duplicates_removed",
        "current_record_groups"
      ],
      "properties": {
        "records_identified": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates_removed": {
          "type": "integer",
          "minimum": 0
        },
        "current_record_groups": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "working_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RECORD_SCREEN_EXCLUDED",
        "RETAIN_OR_LINK_AUTHOR_ADOPTED",
        "FORMAL_HOLD",
        "RETAIN_OR_LINK_TECHNICAL_EXISTING_POLICY"
      ],
      "properties": {
        "RECORD_SCREEN_EXCLUDED": {
          "type": "integer",
          "minimum": 0
        },
        "RETAIN_OR_LINK_AUTHOR_ADOPTED": {
          "type": "integer",
          "minimum": 0
        },
        "FORMAL_HOLD": {
          "type": "integer",
          "minimum": 0
        },
        "RETAIN_OR_LINK_TECHNICAL_EXISTING_POLICY": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "record_route_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_record_screen_excluded",
        "new_record_screen_dispositions",
        "prior_exclusion_reversed_by_actual_source_scope",
        "net_record_screen_exclusion_delta",
        "reused_specific_source_dispositions",
        "new153_source_dispositions",
        "parent_trials_excluded_by_source_role_projection"
      ],
      "properties": {
        "previous_record_screen_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "new_record_screen_dispositions": {
          "type": "integer",
          "minimum": 0
        },
        "prior_exclusion_reversed_by_actual_source_scope": {
          "type": "integer",
          "minimum": 0
        },
        "net_record_screen_exclusion_delta": {
          "type": "integer",
          "minimum": 0
        },
        "reused_specific_source_dispositions": {
          "type": "integer",
          "minimum": 0
        },
        "new153_source_dispositions": {
          "type": "integer",
          "minimum": 0
        },
        "parent_trials_excluded_by_source_role_projection": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "human_review_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_receipt_files",
        "actual_top_level_choice_cells",
        "actual_A_choices",
        "source_actions_per_role",
        "clinical_source_cases",
        "source_vector153_rows",
        "new31_source_vector_rows",
        "two_reviewer_unresolved_source_actions_adjudicated",
        "Yin_dissents_to_agreed_two_reviewer_actions_retained"
      ],
      "properties": {
        "actual_receipt_files": {
          "type": "integer",
          "minimum": 0
        },
        "actual_top_level_choice_cells": {
          "type": "integer",
          "minimum": 0
        },
        "actual_A_choices": {
          "type": "integer",
          "minimum": 0
        },
        "source_actions_per_role": {
          "type": "integer",
          "minimum": 0
        },
        "clinical_source_cases": {
          "type": "integer",
          "minimum": 0
        },
        "source_vector153_rows": {
          "type": "integer",
          "minimum": 0
        },
        "new31_source_vector_rows": {
          "type": "integer",
          "minimum": 0
        },
        "two_reviewer_unresolved_source_actions_adjudicated": {
          "type": "integer",
          "minimum": 0
        },
        "Yin_dissents_to_agreed_two_reviewer_actions_retained": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "review_method_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "two_reviewers_agreement_then_actual_adjudicator_for_their_unresolved_difference",
        "third_author_dissent_to_agreed_reviewers_preserved",
        "majority_voting",
        "independent_duplicate_human_original_fulltext_reading_established_by_receipts",
        "actual_work"
      ],
      "properties": {
        "two_reviewers_agreement_then_actual_adjudicator_for_their_unresolved_difference": {
          "type": "boolean"
        },
        "third_author_dissent_to_agreed_reviewers_preserved": {
          "type": "boolean"
        },
        "majority_voting": {
          "type": "boolean"
        },
        "independent_duplicate_human_original_fulltext_reading_established_by_receipts": {
          "type": "boolean"
        },
        "actual_work": {
          "type": "string"
        }
      }
    },
    "source_use_adoptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_use_rows",
        "limited_whole_package_narrative_uses",
        "nonrandom_or_mixed_design_limits",
        "companion_or_protocol_uses",
        "carrier_without_own_target_result",
        "not_18_additional_independent_trials"
