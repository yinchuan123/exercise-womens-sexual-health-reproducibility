    "received_material_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf_carriers",
        "workbooks",
        "requested_targets_identity_matched",
        "requested_targets_unobtained_closed",
        "different_report_supplied",
        "receipt_is_not_scientific_admission"
      ],
      "properties": {
        "pdf_carriers": {
          "type": "integer",
          "minimum": 0
        },
        "workbooks": {
          "type": "integer",
          "minimum": 0
        },
        "requested_targets_identity_matched": {
          "type": "integer",
          "minimum": 0
        },
        "requested_targets_unobtained_closed": {
          "type": "integer",
          "minimum": 0
        },
        "different_report_supplied": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_is_not_scientific_admission": {
          "type": "boolean"
        }
      }
    },
    "previously_adopted_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_reports",
        "source_supported_family_groups",
        "principal_reports",
        "principal_family_groups",
        "is_final_whole_search_independent_census"
      ],
      "properties": {
        "result_reports": {
          "type": "integer",
          "minimum": 0
        },
        "source_supported_family_groups": {
          "type": "integer",
          "minimum": 0
        },
        "principal_reports": {
          "type": "integer",
          "minimum": 0
        },
        "principal_family_groups": {
          "type": "integer",
          "minimum": 0
        },
        "is_final_whole_search_independent_census": {
          "type": "boolean"
        }
      }
    },
    "numeric_gate_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_carriers_checked",
        "source_endpoint_objects",
        "technical_source_component_candidates",
        "direct_reported_coefficient_SE_candidates",
        "new_numeric_inputs",
        "new_model_fits",
        "new_GRADE_admissions",
        "source_components_not_new_effects_or_studies"
      ],
      "properties": {
        "source_carriers_checked": {
          "type": "integer",
          "minimum": 0
        },
        "source_endpoint_objects": {
          "type": "integer",
          "minimum": 0
        },
        "technical_source_component_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "direct_reported_coefficient_SE_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "new_numeric_inputs": {
          "type": "integer",
          "minimum": 0
        },
        "new_model_fits": {
          "type": "integer",
          "minimum": 0
        },
        "new_GRADE_admissions": {
          "type": "integer",
          "minimum": 0
        },
        "source_components_not_new_effects_or_studies": {
          "type": "boolean"
        }
      }
    },
    "remaining_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_PRISMA",
        "whole_review_independent_K",
        "whole_review_unique_N",
        "submission_ready",
        "working_routes_not_sequential_PRISMA_stages",
        "no_missing_result_is_automatic_trial_exclusion",
        "new_scope_adoption_not_effect_admission",
        "previous_scoped_GRADE_differences_preserved"
      ],
      "properties": {
        "final_PRISMA": {
          "type": "boolean"
        },
        "whole_review_independent_K": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": 0
        },
        "whole_review_unique_N": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": 0
        },
        "submission_ready": {
          "type": "boolean"
        },
        "working_routes_not_sequential_PRISMA_stages": {
          "type": "boolean"
        },
        "no_missing_result_is_automatic_trial_exclusion": {
          "type": "boolean"
        },
        "new_scope_adoption_not_effect_admission": {
          "type": "boolean"
        },
        "previous_scoped_GRADE_differences_preserved": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "historical_reproduction_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "tag",
        "model_reproduction_command",
        "historical_numerical_inputs_not_replaced_by_this_process_snapshot"
      ],
      "properties": {
        "git_commit": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "model_reproduction_command": {
          "type": "string"
        },
        "historical_numerical_inputs_not_replaced_by_this_process_snapshot": {
          "type": "boolean"
        }
      }
    }
